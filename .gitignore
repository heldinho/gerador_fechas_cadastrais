# Dependências baixadas pelo npm (recriáveis com `npm install`)
node_modules/

# Pasta gerada pelo `npm run build` (o "site pronto" compilado)
dist/
dist-ssr/

# Arquivos gerados pelos scripts de verificação (rode `npm run sample` para recriar)
scripts/sample-output.pdf
scripts/sample-output.png

# Informações de compilação do TypeScript
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variáveis locais e secrets
.env
.env.*
!.env.example

# Editor de código e sistema
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
